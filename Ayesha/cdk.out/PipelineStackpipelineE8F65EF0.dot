digraph G {
  # Arrows represent an "unlocks" relationship (opposite of dependency). So chosen
  # because the layout looks more natural that way.
  # To represent subgraph dependencies, subgraphs are represented by BEGIN/END nodes.
  # To render: `dot -Tsvg PipelineStackpipelineE8F65EF0.dot > graph.svg`, open in a browser.
  node [shape="box"];
"BEGIN Build" [shape="cds", style="filled", fillcolor="#b7deff"];
"END Build" [shape="cds", style="filled", fillcolor="#b7deff"];
"Build.Synth";
"Source.AyeshaOmer/ProjectName" -> "Build.Synth";
"BEGIN Build" -> "Build.Synth";
"Build.Synth" -> "END Build";
"BEGIN UpdatePipeline" [shape="cds", style="filled", fillcolor="#b7deff"];
"END UpdatePipeline" [shape="cds", style="filled", fillcolor="#b7deff"];
"UpdatePipeline.SelfMutate";
"Build.Synth" -> "UpdatePipeline.SelfMutate";
"BEGIN UpdatePipeline" -> "UpdatePipeline.SelfMutate";
"UpdatePipeline.SelfMutate" -> "END UpdatePipeline";
"BEGIN Assets" [shape="cds", style="filled", fillcolor="#b7deff"];
"END Assets" [shape="cds", style="filled", fillcolor="#b7deff"];
"Assets.FileAsset1";
"UpdatePipeline.SelfMutate" -> "Assets.FileAsset1";
"BEGIN Assets" -> "Assets.FileAsset1";
"Assets.FileAsset1" -> "END Assets";
"BEGIN UnitTestStage" [shape="cds", style="filled", fillcolor="#b7deff"];
"END UnitTestStage" [shape="cds", style="filled", fillcolor="#b7deff"];
"UpdatePipeline.SelfMutate" -> "BEGIN UnitTestStage";
"BEGIN UnitTestStage.App" [shape="cds", style="filled", fillcolor="#b7deff"];
"END UnitTestStage.App" [shape="cds", style="filled", fillcolor="#b7deff"];
"UnitTestStage.App.Deploy";
"UnitTestStage.App.Prepare" -> "UnitTestStage.App.Deploy";
"UnitTestStage.App.Prepare";
"Build.Synth" -> "UnitTestStage.App.Prepare";
"Assets.FileAsset1" -> "UnitTestStage.App.Prepare";
"BEGIN UnitTestStage.App" -> "UnitTestStage.App.Prepare";
"UnitTestStage.App.Deploy" -> "END UnitTestStage.App";
"BEGIN UnitTestStage" -> "BEGIN UnitTestStage.App";
"END UnitTestStage.App" -> "END UnitTestStage";
"BEGIN Source" [shape="cds", style="filled", fillcolor="#b7deff"];
"END Source" [shape="cds", style="filled", fillcolor="#b7deff"];
"Source.AyeshaOmer/ProjectName";
"BEGIN Source" -> "Source.AyeshaOmer/ProjectName";
"Source.AyeshaOmer/ProjectName" -> "END Source";
}